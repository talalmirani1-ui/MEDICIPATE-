{
  "id": "/?source=pwa",
  "name": "MEDICIPATE — Learn • Master • Advance",
  "short_name": "MEDICIPATE",
  "description": "High-yield medical education, QBank practice, clinical reasoning and exam preparation.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#061326",
  "theme_color": "#061326",
  "orientation": "portrait-primary",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["education", "medical", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MEDICIPATE home screen on mobile"
    },
    {
      "src": "/screenshots/desktop-qbank.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "QBank practice view on desktop"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+medicipate",
      "url": "/open?ref=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/qbank/import",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "QBank Practice",
      "short_name": "QBank",
      "description": "Jump straight into QBank practice questions",
      "url": "/qbank?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Study Library",
      "short_name": "Library",
      "description": "Open the high-yield study library",
      "url": "/library?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
